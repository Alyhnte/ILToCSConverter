<Window x:Class="ILToCSConverter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Height="880" Width="1100"
        MinHeight="720" MinWidth="920"
        Background="{DynamicResource Bg}"
        FontFamily="Segoe UI"
        AllowDrop="True"
        DragOver="OnDragOver"
        Drop="OnDrop">

    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                    Content="{Binding ThemeButtonLabel}"
                    Command="{Binding ToggleThemeCommand}" />
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Hint}" Text="{Binding Ui[Subtitle]}" />
            </StackPanel>
        </DockPanel>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding CpuInfo}" Style="{StaticResource Hint}" Margin="0,10,0,0" />

        <TabControl SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0">
            <TabItem Header="{Binding Ui[TabConvert]}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Background="{DynamicResource Card}" CornerRadius="10" Padding="16" BorderBrush="{DynamicResource Line}" BorderThickness="1" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="{Binding Ui[Source]}" />
                            <Grid Grid.Row="1" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox IsEditable="True" ItemsSource="{Binding RecentInputs}"
                                          Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}" />
                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="{Binding Ui[Folder]}" Margin="8,0,0,0" Command="{Binding BrowseInputCommand}" />
                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="{Binding Ui[File]}" Margin="8,0,0,0" Command="{Binding BrowseInputFileCommand}" />
                            </Grid>
                            <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="{Binding Ui[Target]}" />
                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox IsEditable="True" ItemsSource="{Binding RecentOutputs}"
                                          Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}" />
                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="{Binding Ui[Folder]}" Margin="8,0,0,0" Command="{Binding BrowseOutputCommand}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="{DynamicResource Card}" CornerRadius="10" Padding="16" BorderBrush="{DynamicResource Line}" BorderThickness="1" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="{Binding Ui[Options]}" />
                            <WrapPanel>
                                <CheckBox Content="{Binding Ui[OptRecursive]}" IsChecked="{Binding Recursive}" />
                                <CheckBox Content="{Binding Ui[OptVerify]}" IsChecked="{Binding VerifyBuild}" />
                                <CheckBox Content="{Binding Ui[OptFormat]}" IsChecked="{Binding FormatOutput}" />
                                <CheckBox Content="{Binding Ui[OptGlobal]}" IsChecked="{Binding IncludeGlobalNamespace}" />
                                <CheckBox Content="{Binding Ui[OptCompiler]}" IsChecked="{Binding IncludeCompilerGenerated}" />
                                <CheckBox Content="{Binding Ui[OptSolution]}" IsChecked="{Binding GenerateSolution}" />
                                <CheckBox Content="{Binding Ui[OptBaml]}" IsChecked="{Binding DecompileBaml}" />
                                <CheckBox Content="{Binding Ui[OptPdb]}" IsChecked="{Binding UsePdb}" />
                            </WrapPanel>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Label}" Text="{Binding Ui[CSharpVersion]}" />
                                    <ComboBox ItemsSource="{Binding LanguageChoices}" SelectedItem="{Binding LanguageVersion}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource Label}" Text="{Binding Ui[Parallelism]}" />
                                    <TextBox Text="{Binding Parallelism, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Background="{DynamicResource Card}" CornerRadius="10" Padding="16" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                        <Button Style="{StaticResource PrimaryButton}" Content="{Binding Ui[Start]}" Command="{Binding StartCommand}" />
                                        <Button Style="{StaticResource GhostButton}" Content="{Binding PauseLabel}" Margin="8,0,0,0" Command="{Binding PauseCommand}" />
                                        <Button Style="{StaticResource DangerButton}" Content="{Binding Ui[Cancel]}" Margin="8,0,0,0" Command="{Binding CancelCommand}" />
                                        <Button Style="{StaticResource GhostButton}" Content="{Binding Ui[OpenOutput]}" Margin="8,0,0,0" Command="{Binding OpenOutputCommand}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" />
                                        <ProgressBar Height="8" Margin="0,8,16,0" Minimum="0" Maximum="{Binding ProgressMaximum}" Value="{Binding ProgressValue}" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Label}" Text="{Binding Ui[Log]}" />
                                <ListBox x:Name="LogList" ItemsSource="{Binding Logs}" BorderThickness="0"
                                         Background="{DynamicResource LogBg}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Time}" Foreground="{DynamicResource Muted}" FontSize="12" />
                                                <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap"
                                                           Foreground="{Binding Level, Converter={StaticResource LevelBrush}}" FontSize="13" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{DynamicResource Card}" CornerRadius="10" Padding="16" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{Binding Ui[LoadTypes]}" Command="{Binding LoadPreviewCommand}" />
                                    <TextBlock Style="{StaticResource Label}" Text="{Binding Ui[Preview]}" VerticalAlignment="Center" />
                                </DockPanel>
                                <ListBox DockPanel.Dock="Left" Width="200" Margin="0,0,8,0"
                                         ItemsSource="{Binding PreviewTypes}"
                                         SelectedItem="{Binding SelectedPreviewType}"
                                         DisplayMemberPath="FullName"
                                         Background="{DynamicResource LogBg}" BorderThickness="0" />
                                <TextBox Text="{Binding PreviewCode, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                         FontFamily="Cascadia Code, Consolas" FontSize="12"
                                         Background="{DynamicResource CodeBg}" Foreground="#E2E8F0"
                                         BorderThickness="0" />
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{Binding Ui[TabDuzun]}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Background="{DynamicResource Card}" CornerRadius="10" Padding="16" BorderBrush="{DynamicResource Line}" BorderThickness="1" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="{Binding Ui[DuzunTitle]}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding Ui[DuzunHint]}" />
                            <TextBlock Style="{StaticResource Label}" Text="{Binding Ui[Source]}" Margin="0,12,0,6" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox IsEditable="True" ItemsSource="{Binding RecentDuzunInputs}"
                                          Text="{Binding DuzunInputPath, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="{Binding Ui[Folder]}" Margin="8,0,0,0" Command="{Binding BrowseDuzunInputCommand}" />
                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="{Binding Ui[File]}" Margin="8,0,0,0" Command="{Binding BrowseDuzunInputFileCommand}" />
                            </Grid>
                            <TextBlock Style="{StaticResource Label}" Text="{Binding Ui[TargetOptional]}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox IsEditable="True" ItemsSource="{Binding RecentDuzunOutputs}"
                                          Text="{Binding DuzunOutputPath, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="{Binding Ui[Folder]}" Margin="8,0,0,0" Command="{Binding BrowseDuzunOutputCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Background="{DynamicResource Card}" CornerRadius="10" Padding="16" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button Style="{StaticResource PrimaryButton}" Content="{Binding Ui[DuzunStart]}" Command="{Binding StartDuzunCommand}" />
                                    <Button Style="{StaticResource GhostButton}" Content="{Binding PauseLabel}" Margin="8,0,0,0" Command="{Binding PauseCommand}" />
                                    <Button Style="{StaticResource DangerButton}" Content="{Binding Ui[Cancel]}" Margin="8,0,0,0" Command="{Binding CancelCommand}" />
                                    <Button Style="{StaticResource GhostButton}" Content="{Binding Ui[OpenOutput]}" Margin="8,0,0,0" Command="{Binding OpenOutputCommand}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" />
                                    <ProgressBar Height="8" Margin="0,8,16,0" Minimum="0" Maximum="{Binding ProgressMaximum}" Value="{Binding ProgressValue}" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Label}" Text="{Binding Ui[Log]}" />
                            <ListBox x:Name="DuzunLogList" ItemsSource="{Binding DuzunLogs}" BorderThickness="0"
                                     Background="{DynamicResource LogBg}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Time}" Foreground="{DynamicResource Muted}" FontSize="12" />
                                            <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap"
                                                       Foreground="{Binding Level, Converter={StaticResource LevelBrush}}" FontSize="13" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="{Binding Ui[TabPack]}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Background="{DynamicResource Card}" CornerRadius="10" Padding="16" BorderBrush="{DynamicResource Line}" BorderThickness="1" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="{Binding Ui[PackTitle]}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding Ui[PackHint]}" />
                            <TextBlock Style="{StaticResource Label}" Text="{Binding Ui[PackSourceIl]}" Margin="0,12,0,6" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox IsEditable="True" ItemsSource="{Binding RecentPackInputs}"
                                          Text="{Binding PackInputPath, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}" />
                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="{Binding Ui[Folder]}" Margin="8,0,0,0" Command="{Binding BrowsePackInputCommand}" />
                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="{Binding Ui[File]}" Margin="8,0,0,0" Command="{Binding BrowsePackInputFileCommand}" />
                            </Grid>
                            <TextBlock Style="{StaticResource Label}" Text="{Binding Ui[PackTargetDll]}" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox IsEditable="True" ItemsSource="{Binding RecentPackOutputs}"
                                          Text="{Binding PackOutputPath, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}" />
                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="{Binding Ui[Folder]}" Margin="8,0,0,0" Command="{Binding BrowsePackOutputCommand}" />
                            </Grid>
                            <TextBlock Style="{StaticResource Label}" Text="{Binding Ui[PackSnk]}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding SnkPath, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding PackSigningEnabled}" />
                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="{Binding Ui[Select]}" Margin="8,0,0,0" Command="{Binding BrowseSnkCommand}" />
                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="{Binding Ui[GenerateKey]}" Margin="8,0,0,0" Command="{Binding GenerateSnkCommand}" />
                            </Grid>
                            <WrapPanel Margin="0,10,0,0">
                                <CheckBox Content="{Binding Ui[OptGenerateSnk]}"
                                          IsChecked="{Binding GenerateSnkIfMissing}"
                                          IsEnabled="{Binding PackSigningEnabled}" />
                                <CheckBox Content="{Binding Ui[OptStrip]}"
                                          IsChecked="{Binding StripSignature}"
                                          IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}" />
                                <CheckBox Content="{Binding Ui[OptReplaceAll]}"
                                          IsChecked="{Binding ReplaceAllExternTokens}"
                                          IsEnabled="{Binding PackSigningEnabled}" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Label}" Text="{Binding Ui[TokenMap]}" Margin="0,8,0,6" />
                            <TextBox Text="{Binding TokenMap, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding PackSigningEnabled}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding Ui[TokenMapHint]}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Background="{DynamicResource Card}" CornerRadius="10" Padding="16" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button Style="{StaticResource PrimaryButton}" Content="{Binding PackActionLabel}" Command="{Binding StartPackCommand}" />
                                    <Button Style="{StaticResource GhostButton}" Content="{Binding PauseLabel}" Margin="8,0,0,0" Command="{Binding PauseCommand}" />
                                    <Button Style="{StaticResource DangerButton}" Content="{Binding Ui[Cancel]}" Margin="8,0,0,0" Command="{Binding CancelCommand}" />
                                    <Button Style="{StaticResource GhostButton}" Content="{Binding Ui[OpenOutput]}" Margin="8,0,0,0" Command="{Binding OpenOutputCommand}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" />
                                    <ProgressBar Height="8" Margin="0,8,16,0" Minimum="0" Maximum="{Binding ProgressMaximum}" Value="{Binding ProgressValue}" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Label}" Text="{Binding Ui[Log]}" />
                            <ListBox x:Name="PackLogList" ItemsSource="{Binding PackLogs}" BorderThickness="0"
                                     Background="{DynamicResource LogBg}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Time}" Foreground="{DynamicResource Muted}" FontSize="12" />
                                            <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap"
                                                       Foreground="{Binding Level, Converter={StaticResource LevelBrush}}" FontSize="13" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="{Binding Ui[TabSettings]}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0">
                    <StackPanel>
                        <Border Background="{DynamicResource Card}" CornerRadius="10" Padding="16" BorderBrush="{DynamicResource Line}" BorderThickness="1" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Label}" Text="{Binding Ui[SettingsTitle]}" />
                                <TextBlock Style="{StaticResource Hint}" Text="{Binding Ui[SettingsHint]}" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Label}" Text="{Binding Ui[SettingsLanguage]}" />
                                        <ComboBox ItemsSource="{Binding UiLanguages}"
                                                  DisplayMemberPath="NativeName"
                                                  SelectedValuePath="Code"
                                                  SelectedValue="{Binding UiLanguage}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource Label}" Text="{Binding Ui[SettingsAppearance]}" />
                                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                                Content="{Binding ThemeButtonLabel}"
                                                Command="{Binding ToggleThemeCommand}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Background="{DynamicResource Card}" CornerRadius="10" Padding="16" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Label}" Text="{Binding Ui[GitHubTitle]}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="{Binding Ui[GitHubHint]}" />
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="72" Height="72" CornerRadius="8" ClipToBounds="True"
                                                BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource LogBg}">
                                            <Image Source="{Binding GitHubAvatarUrl}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Label}" Text="{Binding Ui[Author]}" Margin="0,0,0,2" />
                                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding GitHubUser}" />
                                            <TextBlock Margin="0,4,0,0">
                                                <Hyperlink Command="{Binding OpenGitHubProfileCommand}">
                                                    <Run Text="{Binding GitHubProfileUrl, Mode=OneWay}" />
                                                </Hyperlink>
                                            </TextBlock>
                                            <TextBlock Margin="0,4,0,0">
                                                <Hyperlink Command="{Binding OpenPatreonCommand}">
                                                    <Run Text="{Binding PatreonUrl, Mode=OneWay}" />
                                                </Hyperlink>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <Button Style="{StaticResource PrimaryButton}" Content="{Binding Ui[OpenProfile]}" Command="{Binding OpenGitHubProfileCommand}" />
                                        <Button Style="{StaticResource GhostButton}" Content="{Binding Ui[OpenRepo]}" Margin="8,0,0,0" Command="{Binding OpenGitHubRepoCommand}" />
                                        <Button Style="{StaticResource GhostButton}" Content="{Binding Ui[OpenPatreon]}" Margin="8,0,0,0" Command="{Binding OpenPatreonCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{DynamicResource Card}" CornerRadius="10" Padding="16" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Label}" Text="{Binding Ui[UpdateTitle]}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="{Binding Ui[UpdateHint]}" />
                                    <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="{Binding InstalledVersionText}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="{Binding UpdateStatus}" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <Button Style="{StaticResource PrimaryButton}" Content="{Binding Ui[CheckUpdates]}" Command="{Binding CheckUpdatesCommand}"
                                                IsEnabled="{Binding UpdateBusy, Converter={StaticResource InverseBool}}" />
                                        <Button Style="{StaticResource GhostButton}" Content="{Binding Ui[OpenReleases]}" Margin="8,0,0,0" Command="{Binding OpenReleasesCommand}" />
                                        <Button Style="{StaticResource PrimaryButton}" Content="{Binding Ui[DownloadLatest]}" Margin="8,0,0,0" Command="{Binding OpenLatestDownloadCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
