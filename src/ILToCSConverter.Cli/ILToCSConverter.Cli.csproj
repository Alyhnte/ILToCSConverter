<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ILToCS</AssemblyName>
    <RootNamespace>ILToCSConverter.Cli</RootNamespace>
    <DebugType>embedded</DebugType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>il2cs</ToolCommandName>
    <PackageId>il2cs</PackageId>
    <IsPackable>true</IsPackable>
    <PackageDescription>IL, DLL and EXE to C# projects; Düzün (DLL→IL); IL→DLL with your own SNK. UI: Turkish, English, Russian.</PackageDescription>
    <PackageTags>ilspy;decompiler;ildasm;ilasm;csharp;strong-name</PackageTags>
    <PackageProjectUrl>https://github.com/Alyhnte/ILToCSConverter</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Alyhnte/ILToCSConverter</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ILToCSConverter.Core\ILToCSConverter.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
